rules_version = '2';

// =============================================================================
// CareQueue+ Firestore security rules
//
// NOT DEPLOYED YET. Until these are live, your database accepts writes from
// anyone holding the (public) API key in google-services.json. The app checks
// ownership in code, but the database does not enforce it.
//
// To deploy, from the project root with the Firebase CLI:
//     firebase deploy --only firestore:rules
// or paste this file into Firebase Console -> Firestore Database -> Rules.
//
// Deploy to a project you can afford to break and watch the app afterwards:
// rules are the one change that can lock every client out at once.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers --
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Roles live on the user document, which only an admin may change.
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEntryOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // --------------------------------------------------------------- users --
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      // A user may update their own profile (name, FCM token) but must not be
      // able to promote themselves to admin.
      allow update: if isSelf(userId) &&
        (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isSelf(userId);
    }

    // ---------------------------------------------------------- businesses --
    match /businesses/{businessId} {
      // Customers browse the service list before signing in.
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------- queues --
    match /queues/{queueId} {
      // Live queue state (status, "now serving") is public to the app.
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        // Joining is a transaction that bumps currentNumber. Nothing else about
        // a queue may be changed by a customer.
        (signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentNumber']));
    }

    // ------------------------------------------------------- queue entries --
    match /queueEntries/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'WAITING' &&
        request.resource.data.queueNumber is int;

      // Admins advance anyone's entry (CALLED / SERVED / SKIPPED). A customer may
      // only cancel their own, or refresh their own wait estimate — never mark
      // themselves served.
      allow update: if isAdmin() ||
        (isEntryOwner() && request.resource.data.status in ['WAITING', 'CANCELLED']);

      allow delete: if isAdmin() || isEntryOwner();
    }

    // -------------------------------------------------------- service stats --
    match /serviceStats/{docId} {
      allow read, write: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
